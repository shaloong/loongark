{
  "extends": "./tsconfig.playwright.json",
  "compilerOptions": {
    "paths": {
      "@shaloong/loongark-react/*": ["./packages/react/dist/entries/*.d.ts"],
      "@shaloong/loongark-react/editors": ["./packages/react/dist/components/editors.d.ts"],
      "@shaloong/loongark-vue/*": ["./packages/vue/dist/entries/*.d.ts"],
      "@shaloong/loongark-vue/editors": ["./packages/vue/dist/components/editors.d.ts"],
      "@shaloong/loongark-solid/*": ["./packages/solid/dist/entries/*.d.ts"],
      "@shaloong/loongark-solid/editors": ["./packages/solid/dist/components/editors.d.ts"],
      "@shaloong/loongark-svelte/*": ["./packages/svelte/dist/entries/*.d.ts"],
      "@shaloong/loongark-svelte/editors": ["./packages/svelte/dist/components/editors.d.ts"],
      "@shaloong/loongark-primitives/*": ["./packages/primitives/dist/*.d.ts"],
      "@shaloong/loongark-primitives/pin-input": ["./packages/primitives/dist/pinInput.d.ts"],
      "@shaloong/loongark-tokens": ["./packages/tokens/dist/index.d.ts"],
      "@shaloong/loongark-theme": ["./packages/theme/dist/index.d.ts"],
      "@shaloong/loongark-primitives": ["./packages/primitives/dist/index.d.ts"],
      "@shaloong/loongark-kit": ["./packages/kit/dist/index.d.ts"],
      "@shaloong/loongark-kit/*": ["./packages/kit/dist/*.d.ts"],
      "@shaloong/loongark-react": ["./packages/react/dist/index.d.ts"],
      "@shaloong/loongark-vue": ["./packages/vue/dist/index.d.ts"],
      "@shaloong/loongark-solid": ["./packages/solid/dist/index.d.ts"],
      "@shaloong/loongark-svelte": ["./packages/svelte/dist/index.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["tests/consumers/vue/**/*", "tests/consumers/examples-vue/**/*"],
  "exclude": ["node_modules", "dist"]
}
