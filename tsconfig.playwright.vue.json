{
  "extends": "./tsconfig.playwright.json",
  "compilerOptions": {
    "paths": {
      "@loongark/react/*": ["./packages/react/dist/entries/*.d.ts"],
      "@loongark/react/editors": ["./packages/react/dist/components/editors.d.ts"],
      "@loongark/vue/*": ["./packages/vue/dist/entries/*.d.ts"],
      "@loongark/vue/editors": ["./packages/vue/dist/components/editors.d.ts"],
      "@loongark/solid/*": ["./packages/solid/dist/entries/*.d.ts"],
      "@loongark/solid/editors": ["./packages/solid/dist/components/editors.d.ts"],
      "@loongark/svelte/*": ["./packages/svelte/dist/entries/*.d.ts"],
      "@loongark/svelte/editors": ["./packages/svelte/dist/components/editors.d.ts"],
      "@loongark/primitives/*": ["./packages/primitives/dist/*.d.ts"],
      "@loongark/primitives/pin-input": ["./packages/primitives/dist/pinInput.d.ts"],
      "@loongark/tokens": ["./packages/tokens/dist/index.d.ts"],
      "@loongark/theme": ["./packages/theme/dist/index.d.ts"],
      "@loongark/primitives": ["./packages/primitives/dist/index.d.ts"],
      "@loongark/kit": ["./packages/kit/dist/index.d.ts"],
      "@loongark/kit/*": ["./packages/kit/dist/*.d.ts"],
      "@loongark/react": ["./packages/react/dist/index.d.ts"],
      "@loongark/vue": ["./packages/vue/dist/index.d.ts"],
      "@loongark/solid": ["./packages/solid/dist/index.d.ts"],
      "@loongark/svelte": ["./packages/svelte/dist/index.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["tests/consumers/vue/**/*", "tests/consumers/examples-vue/**/*"],
  "exclude": ["node_modules", "dist"]
}
