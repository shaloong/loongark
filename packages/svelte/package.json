{
  "name": "@loongark/svelte",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "dependencies": {
    "@ark-ui/svelte": "^5.15.0",
    "@loongark/kit": "workspace:*",
    "@loongark/primitives": "workspace:*",
    "@loongark/theme": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5.20.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": false
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-assets.mjs src dist .svelte .d.ts && node ../../scripts/fix-dist-imports.mjs dist"
  }
}
