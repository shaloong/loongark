  "notableFixes": [
    "Floating action buttons use the established 40/48/56px size scale, pill radius, neutral semantic colors and type=button",
    "SpeedDial supports controlled/uncontrolled open state, visible action labels, disabled skipping, keyboard focus loops and outside dismissal with listener/RAF cleanup",
    "Explicit native-button selector specificity prevents generic Trigger rules from overriding SpeedDial radius, foreground and background; actual computed appearance is checked in four frameworks",
    "ImageList clamps spans to inherited responsive columns; figure/figcaption and native image attributes are preserved",
    "Masonry preserves natural image ratios and DOM reading order using CSS columns without runtime height measurement"
  ],
  "testHarnessFixes": [
    "Wait for asynchronous anchored-overlay positioning to settle after viewport resize before measuring page width; added light/dark repeated date-range resize regression. Initial light layout timing failure is superseded by the complete layout rerun."
  ],
