{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "outDir": "dist",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [],
    "paths": {
      "@shaloong/loongark-tokens": [
        "./packages/tokens/src"
      ],
      "@shaloong/loongark-theme": [
        "./packages/theme/src"
      ],
      "@shaloong/loongark-primitives": [
        "./packages/primitives/src"
      ],
      "@shaloong/loongark-kit": [
        "./packages/kit/src"
      ],
      "@shaloong/loongark-vue": [
        "./packages/vue/src"
      ],
      "@shaloong/loongark-react": [
        "./packages/react/src"
      ],
      "@shaloong/loongark-svelte": [
        "./packages/svelte/src"
      ],
      "@shaloong/loongark-solid": [
        "./packages/solid/src"
      ],
      "@shaloong/loongark-cli": [
        "./packages/cli/src"
      ],
      "@examples": [
        "./examples"
      ],
      "@shaloong/loongark-kit/bootstrap": [
        "./packages/kit/src/bootstrap.ts"
      ],
      "@shaloong/loongark-react/*": [
        "./packages/react/src/entries/*"
      ],
      "@shaloong/loongark-vue/*": [
        "./packages/vue/src/entries/*"
      ],
      "@shaloong/loongark-solid/*": [
        "./packages/solid/src/entries/*"
      ],
      "@shaloong/loongark-svelte/*": [
        "./packages/svelte/src/entries/*"
      ],
      "@shaloong/loongark-react/editors": [
        "./packages/react/src/components/editors"
      ],
      "@shaloong/loongark-vue/editors": [
        "./packages/vue/src/components/editors"
      ],
      "@shaloong/loongark-solid/editors": [
        "./packages/solid/src/components/editors"
      ],
      "@shaloong/loongark-svelte/editors": [
        "./packages/svelte/src/components/editors"
      ],
      "@shaloong/loongark-primitives/pin-input": ["./packages/primitives/src/pinInput.ts"],
      "@shaloong/loongark-primitives/*": [
        "./packages/primitives/src/*"
      ]
    }
  }
}
