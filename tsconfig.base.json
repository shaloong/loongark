{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "outDir": "dist",
    "lib": ["ES2020", "DOM"],
    "types": [],
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@loongark/tokens": ["packages/tokens/src"],
      "@loongark/theme": ["packages/theme/src"],
      "@loongark/primitives": ["packages/primitives/src"],
      "@loongark/kit": ["packages/kit/src"],
      "@loongark/vue": ["packages/vue/src"],
      "@loongark/react": ["packages/react/src"],
      "@loongark/svelte": ["packages/svelte/src"],
      "@loongark/solid": ["packages/solid/src"],
      "@loongark/cli": ["packages/cli/src"],
      "@examples": ["examples"]
    }
  }
}
